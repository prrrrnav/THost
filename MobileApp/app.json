{
  "expo": {
    "name": "Host",
    "slug": "MobileApp",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "hostapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.thost.mobileapp"
    },
    "plugins": [
      "@react-native-async-storage/expo-with-async-storage",
      "expo-secure-store",
      "expo-web-browser"
    ],

    "extra": {
      "eas": {
        "projectId": "f0eeecde-2e8e-4e9d-b1da-adf60402a258"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f0eeecde-2e8e-4e9d-b1da-adf60402a258"
    }
  }
}
